<li class="gs-interactable-actors-item{{#unless isShown}} is-hidden{{/unless}}{{#if isCollapsed}} is-collapsed{{/if}}">
  <header class="gs-interactable-actors-item-head">
    <div class="gs-interactable-actors-item-id{{#if isCollapsible}} is-collapsible{{/if}}"
         data-action="{{#if isCollapsible}}toggleDescription{{/if}}" data-key="{{id}}"
         data-tooltip="{{cardTooltip}}" data-tooltip-class="dnd5e2 dnd5e-tooltip item-tooltip"
         data-tooltip-direction="LEFT">
      <img src="{{img}}" alt="" />
      <h4>{{name}}</h4>
    </div>
    {{#if isCollapsible}}
      <button type="button" class="gs-icon-btn dense gs-interactable-actors-collapse"
              data-action="toggleDescription" data-key="{{id}}" data-tooltip="{{collapseLabel}}"
              aria-label="{{collapseLabel}}" aria-expanded="{{#if isCollapsed}}false{{else}}true{{/if}}">
        <i class="fa-solid fa-fw fa-chevron-down" inert></i>
      </button>
    {{/if}}
    {{#if isCurator}}
      {{> "modules/GS-Interactable-Actors/templates/eye.hbs" category="items" key=id}}
    {{/if}}
  </header>
  {{#if descriptionHTML}}
    <div class="gs-interactable-actors-prose">{{{descriptionHTML}}}</div>
  {{/if}}
</li>
