<div class="gs-shell gs-interactable-actors-shell">
  <header class="gs-interactable-actors-banner">
    <h1 class="gs-interactable-actors-name{{#if isCurator}}{{#unless isNameShown}} is-hidden{{/unless}}{{/if}}">
      <span>{{name}}</span>
      {{#if isCurator}}
        <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                data-category="personal" data-key="name" data-tooltip="{{nameToggleLabel}}"
                aria-label="{{nameToggleLabel}}" aria-pressed="{{isNameShown}}">
          <i class="fa-solid fa-fw {{#if isNameShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
        </button>
      {{/if}}
    </h1>
  </header>
  <div class="gs-interactable-actors-body">
    <div class="gs-interactable-actors-portrait-pane">
      <div class="gs-interactable-actors-plate-wrap">
        <div class="gs-interactable-actors-plate" tabindex="0" role="img" aria-label="{{name}}">
          <img class="gs-interactable-actors-backdrop" src="{{portrait}}" alt="" aria-hidden="true" />
          <img class="gs-interactable-actors-portrait" src="{{portrait}}" alt="" />
        </div>
        <button type="button" class="gs-icon-btn gs-interactable-actors-plate-reset" hidden
                data-tooltip="{{localize 'GS-Interactable-Actors.inspect.resetView'}}"
                aria-label="{{localize 'GS-Interactable-Actors.inspect.resetView'}}">
          <i class="fa-solid fa-fw fa-compress" inert></i>
        </button>
      </div>
    </div>
    <div class="gs-scroll gs-interactable-actors-known">
      {{#if lore}}
        <fieldset class="gs-interactable-actors-section has-eye{{#unless lore.isShown}} is-hidden{{/unless}}">
          <legend>
            {{localize 'GS-Interactable-Actors.inspect.lore'}}
            {{#if isCurator}}
                <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                        data-category="personal" data-key="biographyPublic"
                        aria-label="{{lore.toggleLabel}}" aria-pressed="{{lore.isShown}}">
                  <i class="fa-solid fa-fw {{#if lore.isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                </button>
              {{/if}}
          </legend>
          <div class="gs-interactable-actors-prose">{{{lore.html}}}</div>
        </fieldset>
      {{/if}}
      {{#if vitals}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.vitals'}}</legend>
          <dl class="gs-interactable-actors-stats is-vitals">
            {{#each vitals.rows}}
              <div class="gs-interactable-actors-stat gs-interactable-actors-vital{{#unless isKnown}} is-unknown{{/unless}}"
                   data-tooltip="{{truth}}">
                <dt>{{label}}</dt>
                <dd class="gs-figure">{{value}}</dd>
                <span class="gs-interactable-actors-vital-note">{{note}}</span>
                {{#if ../isCurator}}
                  {{#if isKnown}}
                    <button type="button" class="gs-icon-btn dense gs-interactable-actors-forget" data-action="forgetObserved"
                            data-stat="{{stat}}" data-tooltip="{{../vitals.forgetLabel}}"
                            aria-label="{{../vitals.forgetLabel}}">
                      <i class="fa-solid fa-fw fa-rotate-left" inert></i>
                    </button>
                  {{/if}}
                {{/if}}
              </div>
            {{/each}}
          </dl>
        </fieldset>
      {{/if}}
      {{#each defences}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{label}}</legend>
          <ul class="gs-chips">
            {{#each chips}}
              <li>
                {{#if ../../isCurator}}
                  <button type="button" class="gs-interactable-actors-chip{{#unless isShown}} is-hidden{{/unless}}"
                          data-action="toggleReveal" data-category="{{category}}" data-key="{{key}}"
                          aria-pressed="{{isShown}}">
                    <span>{{label}}</span>
                    <i class="fa-solid fa-fw {{#if isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                  </button>
                {{else}}
                  <span class="gs-interactable-actors-chip">{{label}}</span>
                {{/if}}
              </li>
            {{/each}}
          </ul>
          {{#if bypassNote}}
            <p class="gs-interactable-actors-bypass">{{bypassNote}}</p>
          {{/if}}
        </fieldset>
      {{/each}}
      {{#if personal}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.personal'}}</legend>
          {{#if personal.classes.length}}
            <dl class="gs-interactable-actors-class-rows">
              {{#each personal.classes}}
                <div class="gs-interactable-actors-fact">
                  <dt>{{label}}</dt>
                  <dd>
                    <ul class="gs-interactable-actors-classes">
                      {{#each entries}}
                        <li class="gs-interactable-actors-class{{#unless isShown}} is-hidden{{/unless}}">
                          {{#if img}}<img class="gs-interactable-actors-class-icon" src="{{img}}" alt="" loading="lazy" />{{/if}}
                          <span class="gs-interactable-actors-class-name">{{name}}</span>
                          {{#if ../../isCurator}}
                <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                        data-category="personal" data-key="{{key}}"
                        aria-label="{{toggleLabel}}" aria-pressed="{{isShown}}">
                  <i class="fa-solid fa-fw {{#if isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                </button>
              {{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  </dd>
                </div>
              {{/each}}
            </dl>
          {{/if}}
          {{#if personal.facts.length}}
            <dl class="gs-interactable-actors-facts">
              {{#each personal.facts}}
                <div class="gs-interactable-actors-fact{{#unless isShown}} is-hidden{{/unless}}">
                  <dt>
                    {{label}}
                    {{#if ../isCurator}}
                <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                        data-category="personal" data-key="{{key}}"
                        aria-label="{{toggleLabel}}" aria-pressed="{{isShown}}">
                  <i class="fa-solid fa-fw {{#if isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                </button>
              {{/if}}
                  </dt>
                  <dd>{{value}}</dd>
                </div>
              {{/each}}
            </dl>
          {{/if}}
          {{#each personal.passages}}
            <div class="gs-interactable-actors-passage{{#unless isShown}} is-hidden{{/unless}}">
              <h3>
                {{label}}
                {{#if ../isCurator}}
                <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                        data-category="personal" data-key="{{key}}"
                        aria-label="{{toggleLabel}}" aria-pressed="{{isShown}}">
                  <i class="fa-solid fa-fw {{#if isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                </button>
              {{/if}}
              </h3>
              <div class="gs-interactable-actors-prose">{{{html}}}</div>
            </div>
          {{/each}}
        </fieldset>
      {{/if}}
      {{#each biographies}}
        <fieldset class="gs-interactable-actors-section has-eye{{#unless isShown}} is-hidden{{/unless}}">
          <legend>
            {{label}}
            {{#if ../isCurator}}
                <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                        data-category="personal" data-key="{{key}}"
                        aria-label="{{toggleLabel}}" aria-pressed="{{isShown}}">
                  <i class="fa-solid fa-fw {{#if isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                </button>
              {{/if}}
          </legend>
          <div class="gs-interactable-actors-prose">{{{html}}}</div>
        </fieldset>
      {{/each}}
      {{#if statistics.length}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.statistics'}}</legend>
          <dl class="gs-interactable-actors-stats">
            {{#each statistics}}
              <div class="gs-interactable-actors-stat{{#unless isShown}} is-hidden{{/unless}}">
                <dt>{{label}}</dt>
                <dd class="{{#if isFigure}}gs-figure{{/if}}">{{value}}</dd>
                {{#if ../isCurator}}
                  <button type="button" class="gs-icon-btn dense gs-interactable-actors-eye" data-action="toggleReveal"
                          data-category="personal" data-key="{{key}}"
                          aria-label="{{toggleLabel}}" aria-pressed="{{isShown}}">
                    <i class="fa-solid fa-fw {{#if isShown}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
                  </button>
                {{/if}}
              </div>
            {{/each}}
          </dl>
        </fieldset>
      {{/if}}
      {{#if scores.length}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.abilityScores'}}</legend>
          <div class="gs-interactable-actors-scores">
            {{#each scores}}
              {{#if ../isCurator}}
                <button type="button" class="gs-interactable-actors-score{{#unless isShown}} is-hidden{{/unless}}"
                        data-action="toggleReveal" data-category="personal" data-key="{{key}}"
                        aria-pressed="{{isShown}}">
                  <span class="gs-interactable-actors-score-abbr">{{abbr}}</span>
                  <span class="gs-figure">{{value}} <span class="gs-interactable-actors-score-mod">({{mod}})</span></span>
                </button>
              {{else}}
                <div class="gs-interactable-actors-score">
                  <span class="gs-interactable-actors-score-abbr">{{abbr}}</span>
                  <span class="gs-figure">{{value}} <span class="gs-interactable-actors-score-mod">({{mod}})</span></span>
                </div>
              {{/if}}
            {{/each}}
          </div>
        </fieldset>
      {{/if}}
      {{#if proficiencies.length}}
        <fieldset class="gs-interactable-actors-section gs-interactable-actors-proficiencies">
          <legend>{{localize 'GS-Interactable-Actors.inspect.proficiencies'}}</legend>
          {{#each proficiencies}}
            <div class="gs-interactable-actors-proficiency-group">
              <h3 class="gs-interactable-actors-group-heading">{{label}}</h3>
              <ul class="gs-chips">
                {{#each chips}}
                  <li>
                    {{#if ../../isCurator}}
                      <button type="button" class="gs-interactable-actors-chip{{#unless isShown}} is-hidden{{/unless}}"
                              data-action="toggleReveal" data-category="personal" data-key="{{key}}"
                              aria-pressed="{{isShown}}">
                        <span>{{label}}</span>
                        {{#if detail}}<span class="gs-interactable-actors-chip-detail">{{detail}}</span>{{/if}}
                      </button>
                    {{else}}
                      <span class="gs-interactable-actors-chip">
                        <span>{{label}}</span>
                        {{#if detail}}<span class="gs-interactable-actors-chip-detail">{{detail}}</span>{{/if}}
                      </span>
                    {{/if}}
                  </li>
                {{/each}}
              </ul>
            </div>
          {{/each}}
        </fieldset>
      {{/if}}
      {{#if abilityGroups.length}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.abilities'}}</legend>
          {{#each abilityGroups}}
            <h3 class="gs-interactable-actors-list-heading">{{label}}</h3>
            <ul class="gs-interactable-actors-items">
              {{#each abilities}}
                {{> "modules/GS-Interactable-Actors/templates/item-row.hbs" isCurator=../../isCurator}}
              {{/each}}
            </ul>
          {{/each}}
        </fieldset>
      {{/if}}
      {{#if spellGroups.length}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.spells'}}</legend>
          {{#each spellGroups}}
            <h3 class="gs-interactable-actors-level-heading">{{label}}</h3>
            <ul class="gs-interactable-actors-items">
              {{#each spells}}
                {{> "modules/GS-Interactable-Actors/templates/item-row.hbs" isCurator=../../isCurator}}
              {{/each}}
            </ul>
          {{/each}}
        </fieldset>
      {{/if}}
      {{#if relationships}}
        <fieldset class="gs-interactable-actors-section">
          <legend>{{localize 'GS-Interactable-Actors.inspect.relationship'}}</legend>
          <ul class="gs-interactable-actors-relationships">
            {{#each relationships}}
              <li>
                <div class="gs-interactable-actors-relationship-head">
                  <span class="gs-interactable-actors-relationship-label">{{label}}</span>
                  {{#if max}}<span class="gs-figure gs-interactable-actors-relationship-value">{{value}} / {{max}}</span>{{/if}}
                </div>
                {{#if max}}
                  <div class="gs-interactable-actors-meter">
                    <div class="gs-interactable-actors-meter-fill" style="width: {{percent}}%"></div>
                  </div>
                {{/if}}
                {{#if description}}<p class="gs-interactable-actors-relationship-note">{{description}}</p>{{/if}}
              </li>
            {{/each}}
          </ul>
        </fieldset>
      {{/if}}
      {{#if isEmpty}}
        <div class="gs-empty">
          <i class="fa-solid fa-circle-question" inert></i>
          <p>{{localize 'GS-Interactable-Actors.inspect.nothingKnown'}}</p>
        </div>
      {{/if}}
    </div>
  </div>
  <footer class="gs-footer">
    {{#if website}}
      <a href="{{website}}" target="_blank" rel="noopener noreferrer">{{footer}}</a>
    {{else}}
      {{footer}}
    {{/if}}
  </footer>
</div>
